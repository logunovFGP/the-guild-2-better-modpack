14538   "_COMPLIMENT_WEAK_RHETORIC_TOFEMALE_+1"   "#E[LV_FONDLY]J'adore vos mains. Elles sont si fragiles, si pures."   |
14539   "_COMPLIMENT_WEAK_RHETORIC_TOFEMALE_+2"   "#E[LV_FONDLY]Vous avez des cheveux soyeux. Les lavez-vous tous les jours ?"   |
14540   "_COMPLIMENT_WEAK_RHETORIC_TOFEMALE_+3"   "#E[LV_FONDLY]C'est une nouvelle robe ? Elle est si propre..."   |
14541   "_COMPLIMENT_WEAK_RHETORIC_TOFEMALE_+4"   "#E[LV_FONDLY]J'adore votre chaîne de cou. Elle va si bien à votre nuque..."   |
14542   "_COMPLIMENT_NORMAL_RHETORIC_TOMALE_+0"   "#E[LV_FONDLY]Vous êtes bel homme."   |
14543   "_COMPLIMENT_NORMAL_RHETORIC_TOMALE_+1"   "#E[LV_FONDLY]Vous êtes un homme des plus attrayants."   |
14544   "_COMPLIMENT_NORMAL_RHETORIC_TOMALE_+2"   "#E[LV_FONDLY]Votre toilette prouve de la plus belle des façons que vous êtes un homme de goût."   |
14545   "_COMPLIMENT_NORMAL_RHETORIC_TOMALE_+3"   "#E[LV_FONDLY]J'aime beaucoup vos manières."   |
14546   "_COMPLIMENT_NORMAL_RHETORIC_TOMALE_+4"   "#E[LV_FONDLY]Quand je vous vois, je fonds complètement."   |
14547   "_COMPLIMENT_NORMAL_RHETORIC_TOFEMALE_+0"   "#E[LV_FONDLY]Aujourd'hui, vous portez une robe des plus jolies, madame."   |
14548   "_COMPLIMENT_NORMAL_RHETORIC_TOFEMALE_+1"   "#E[LV_FONDLY]Vous êtes une belle femme."   |
14549   "_COMPLIMENT_NORMAL_RHETORIC_TOFEMALE_+2"   "#E[LV_FONDLY]Vous êtes une femme des plus attrayantes."   |
14550   "_COMPLIMENT_NORMAL_RHETORIC_TOFEMALE_+3"   "#E[LV_FONDLY]Vous avez un sourire enjôleur. Je ne sais si je saurai y résister..."   |
14551   "_COMPLIMENT_NORMAL_RHETORIC_TOFEMALE_+4"   "#E[LV_FONDLY]Depuis que j'ai croisé votre regard, je ne pense plus qu'à vous."   |
