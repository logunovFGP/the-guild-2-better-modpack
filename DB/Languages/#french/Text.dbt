18208   "_CHARACTERS_2_PROFESSIONS_lumberjack_LEVEL_2_+0"   "Boquillonne"   |
18209   "_CHARACTERS_2_PROFESSIONS_lumberjack_LEVEL_1_+3"   "Abatteur"   |
18210   "_CHARACTERS_2_PROFESSIONS_lumberjack_LEVEL_1_+2"   "Abatteuse"   |
